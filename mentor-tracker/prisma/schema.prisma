// Postgres schema. Scalable, multi-lead by design: every Mentor is owned by a
// User (a lead), and every Mentee belongs to a Mentor. A lead can only ever see
// their own data — enforced in the API layer via the session user id.
//
// The User/Account/Session/VerificationToken models are the standard NextAuth
// (Auth.js) adapter schema. See:
// https://authjs.dev/reference/adapter/prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Pooled connections (PgBouncer/Neon/Supabase) for the app at runtime; a
  // direct connection for migrations. Both fall back to DATABASE_URL locally.
  directUrl = env("DIRECT_URL")
}

// ---- NextAuth models ----

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  login         String? // GitHub login, cached for display + allowlist checks
  accounts      Account[]
  sessions      Session[]
  mentors       Mentor[]
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---- App models ----

model Mentor {
  id        String   @id @default(cuid())
  userId    String // owning lead
  name      String
  github    String?
  mentees   Mentee[]
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Mentee {
  id        String   @id @default(cuid())
  mentorId  String
  name      String
  email     String
  github    String
  createdAt DateTime @default(now())

  mentor Mentor @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([mentorId])
}

// ---- Public club membership ----
//
// A Member is a club member who has asked to appear on the PUBLIC leaderboard at
// the site root. This is deliberately a separate model from Mentee:
//
//   Mentee  = a private record in a lead's mentorship program. Has an email.
//             Never rendered publicly.
//   Member  = a public, self-service, consented identity. Joins to
//             ContribProfile via `github` to get contribution stats.
//
// Keeping them apart is the whole point. The public leaderboard cannot leak a
// mentee's email address because it does not read the Mentee table at all.
//
// Consent is given by the account owner, not by an admin: /join requires signing
// in with GitHub, so the person granting consent has proved they control the
// account being published. An admin can then approve, but cannot manufacture
// consent for someone who never granted it.

enum MemberStatus {
  PENDING
  APPROVED
  REJECTED
}

model Member {
  id String @id @default(cuid())

  /// GitHub login, always lowercased. Unique, and the join key to
  /// ContribProfile.username, which is lowercased for the same reason.
  github String @unique

  // ---- PUBLIC fields. Safe to render to anyone. ----
  displayName String
  batch       String? // e.g. "2027"
  bio         String? // short, member-authored
  role        String? // e.g. "Core", "Contributor" — club role, not an auth role

  // GSoC targeting. Public, because knowing who is aiming at which organisation
  // is useful to other members and to mentors looking for someone to pair with.
  gsocInterested Boolean @default(false)
  gsocPref1      String? // organisation name, e.g. "CNCF"
  gsocPref2      String?

  // ---- PRIVATE fields. Must never appear in a public response. ----
  // Public queries use PUBLIC_MEMBER_SELECT (lib/public.ts), which does not list
  // these columns at all, so they are not merely filtered after the fact — they
  // are never read out of Postgres on a public code path.
  email String?

  /// Whether they want the inactivity nudge. Opt-OUT, and only ever acted on when
  /// an email address exists — we ask for the address on the join form and state
  /// there exactly what it is used for.
  notifyInactive Boolean   @default(true)
  /// Last nudge sent, so a quiet member is not mailed every time the job runs.
  lastNudgedAt   DateTime?

  /// True only when the account owner explicitly ticked the consent box. Without
  /// it the member never appears publicly regardless of status.
  publicConsent Boolean   @default(false)
  consentedAt   DateTime?

  /// Defaults to APPROVED: joining publishes immediately, with organisers
  /// moderating afterwards rather than gating the queue. That is safe here because
  /// the public leaderboard only shows the top few by merged pull requests, so a
  /// junk signup is not publicly visible without real accepted work behind it.
  /// Organisers set this back to PENDING to take someone down.
  status     MemberStatus @default(APPROVED)
  approvedAt DateTime?
  /// The admin's GitHub login, for an audit trail on who published whom.
  approvedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publicConsent])
}

// ---- Deep contribution profile cache ----
//
// The drill-down view costs ~50-70 GitHub API calls per mentee (GraphQL repo
// discovery + batched search counts + a contributor-rank call per repo + a
// merged-PR file scan). That is far too expensive to run per page view, so the
// whole profile is cached here and refreshed on a TTL (see lib/github-deep.ts).
//
// Keyed by GitHub login, NOT by mentee id: two leads tracking the same username
// share one cache entry. Nothing here is private — it is all public GitHub data
// — so sharing it across tenants leaks nothing. Ownership is still enforced at
// the API route, which refuses to look up a username that isn't one of the
// calling lead's mentees.

model ContribProfile {
  id       String @id @default(cuid())
  username String @unique // GitHub login, lowercased

  // Profile fields, denormalized for a single-query render.
  displayName String?
  avatarUrl   String?
  profileUrl  String?
  followers   Int     @default(0)
  publicRepos Int     @default(0)

  // Windowed contribution totals (GraphQL contributionsCollection is capped at
  // a one-year range per query, so these cover `windowDays` back from fetchedAt).
  windowDays      Int @default(365)
  commitsInWindow Int @default(0)
  prsInWindow     Int @default(0)
  issuesInWindow  Int @default(0)
  reviewsInWindow Int @default(0)

  /// Daily contribution counts, oldest first: [{ date, count }]. Summed across
  /// published members to draw the public site's aggregate club grid.
  dailyContributions         Json?
  totalContributionsInWindow Int   @default(0)

  /// Date of their most recent public contribution, derived from the series above
  /// when the profile is written. Stored rather than computed so the danger-zone
  /// query is an indexed filter instead of parsing every member's JSON.
  lastContributionAt DateTime?

  // All-time totals from the Search API (exact, not windowed).
  totalPRs       Int @default(0)
  totalMergedPRs Int @default(0)
  totalIssues    Int @default(0)

  /// Public repos contributed to, before the REPO_LIMIT truncation — lets the UI
  /// say "showing 20 of 63" instead of implying 20 is the whole story.
  reposContributedTo Int @default(0)

  // Set when the fetch degraded (rate limit, partial GraphQL errors). The UI
  // shows the data with a "partial" marker instead of failing outright.
  partial Boolean @default(false)
  note    String?

  fetchedAt DateTime      @default(now())
  repos     RepoContrib[]
  stackScan StackScan?

  @@index([fetchedAt])
  @@index([lastContributionAt])
}

// ---- Open source calendar ----
//
// GSoC milestones, Hacktoberfest, conference CFP deadlines, club meetups. Public
// and admin-authored, so there is no user input to sanitise and no consent
// question — nothing here describes a person.

enum EventKind {
  GSOC
  HACKTOBERFEST
  CFP
  MEETUP
  DEADLINE
  OTHER
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?
  kind        EventKind @default(OTHER)
  startsAt    DateTime
  /// Null for a single moment in time (a deadline) rather than a span.
  endsAt      DateTime?
  url         String?
  /// Unpublished events are drafts, visible only in /admin.
  isPublished Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, startsAt])
}

// ---- GSoC organisations and their project ideas ----
//
// A browsable board so members can pick a target organisation months before
// applications open, which is when the work that gets someone selected actually
// happens. Admin-curated: organisations publish ideas in wildly different formats,
// so an automated importer would be brittle and wrong more often than useful.

model GsocOrg {
  id           String  @id @default(cuid())
  name         String  @unique
  slug         String  @unique
  description  String?
  /// Comma-separated technologies, e.g. "Go, Kubernetes, gRPC".
  technologies String?
  /// Most recent GSoC year this organisation participated in.
  lastYear     Int?
  url          String?
  ideasUrl     String?
  /// Difficulty of getting selected, as judged by club organisers.
  difficulty   String? // "approachable" | "competitive" | "very competitive"

  ideas     GsocIdea[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model GsocIdea {
  id          String  @id @default(cuid())
  orgId       String
  title       String
  description String?
  skills      String?
  size        String? // "90 hours" | "175 hours" | "350 hours"
  url         String?

  org       GsocOrg  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([orgId])
}

model RepoContrib {
  id        String @id @default(cuid())
  profileId String
  /// Preserves the fetch-time ordering (most of the user's activity first), so a
  /// cached read renders in the same order as a fresh one.
  position  Int    @default(0)

  nameWithOwner   String // "owner/repo"
  url             String
  description     String?
  stars           Int     @default(0)
  primaryLanguage String?
  isOwnRepo       Boolean @default(false)
  isFork          Boolean @default(false)

  // This user's contribution to this repo.
  commits      Int @default(0) // all-time, default branch (contributors endpoint)
  issuesOpened Int @default(0)
  issuesClosed Int @default(0)
  prsOpened    Int @default(0)
  prsMerged    Int @default(0)
  prsOpen      Int @default(0)
  prsClosed    Int @default(0) // closed without merging
  reviews      Int @default(0)

  // Contributor rank by commit count on the default branch. rankStatus says why
  // `rank` is null, which matters: "unranked" (checked, no commits) and
  // "unresolved" (ran out of API budget before finishing) are opposite claims.
  // See the RankStatus union in lib/github-deep.ts.
  //   "ranked" | "unranked" | "outside-window" | "unresolved"
  rank              Int?
  rankStatus        String  @default("unresolved")
  totalContributors Int?
  contributorsExact Boolean @default(false) // false → totalContributors is a lower bound

  lastActivityAt DateTime?

  profile ContribProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, nameWithOwner])
  @@index([profileId])
}

// Tech stack derived from the actual files changed in the user's merged PRs —
// their real diff surface, not the host repo's language breakdown.
model StackScan {
  id         String   @id @default(cuid())
  profileId  String   @unique
  prsScanned Int      @default(0)
  filesSeen  Int      @default(0)
  // [{ label, ext, files, additions, deletions, share }] — see StackEntry.
  entries    Json
  truncated  Boolean  @default(false) // true → hit the PR scan budget
  scannedAt  DateTime @default(now())

  profile ContribProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}
