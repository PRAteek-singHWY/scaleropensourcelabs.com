# ---- Database (Postgres) ----
# Pooled connection string used by the app at runtime (Neon/Supabase/Vercel
# Postgres all give you one). Example:
#   postgresql://user:pass@host/db?sslmode=require&pgbouncer=true
DATABASE_URL=
# Direct (non-pooled) connection used only for migrations / prisma db push.
# If your provider has no separate pooler, set this to the same as DATABASE_URL.
DIRECT_URL=

# ---- GitHub data (server-side only) ----
# REQUIRED for the contribution drill-down (/mentee/:id). That page uses GitHub's
# GraphQL API to discover which repos a mentee contributes to, and GraphQL rejects
# unauthenticated requests outright. It also raises the REST limit 60→5000 req/hr,
# which the ~50-70 requests per profile need.
# A classic PAT with NO scopes is enough — everything read here is public.
# https://github.com/settings/tokens
GITHUB_TOKEN=

# How long a cached deep contribution profile stays fresh, in hours (default 12).
# Profiles are cached in Postgres because each cold fetch is ~50-70 API calls.
DEEP_PROFILE_TTL_HOURS=12

# ---- Auth (NextAuth / GitHub OAuth) ----
# GitHub OAuth App credentials. Create at:
# https://github.com/settings/developers  → New OAuth App
#   Homepage URL:            http://localhost:3000   (or your Vercel URL)
#   Authorization callback:  http://localhost:3000/api/auth/callback/github
GITHUB_OAUTH_ID=
GITHUB_OAUTH_SECRET=

# Comma-separated GitHub usernames allowed to sign in. THIS IS THE GATE.
# If empty, NOBODY can log in (fail closed). Put YOUR github login here.
ALLOWED_LOGINS=your-github-username

# A long random string used to sign session cookies. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# The canonical URL of the app. Local dev: http://localhost:3000
# On Vercel set this to your deployment URL (https://your-app.vercel.app).
NEXTAUTH_URL=http://localhost:3000
