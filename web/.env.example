# All OPTIONAL. The site runs, builds, renders and passes every check with this file
# absent — a contributor fixing a typo does not need a Firebase project. With Firebase
# unconfigured the join form renders and validates as normal and says plainly that it
# is not connected, rather than pretending to submit.
#
# NEXT_PUBLIC_ IS CORRECT HERE AND IS NOT A MISTAKE. A Firebase web config is an
# identifier, not a credential: Google documents it as publishable, and it is inlined
# into the client bundle by design. What protects applicants' data is ../firestore.rules
# — read that file, not this one, if you are reviewing the security of this.
#
# NEVER put a real secret in this file or in any NEXT_PUBLIC_ variable. A service
# account key, an admin SDK credential or an API token with write scope does not belong
# in the browser. If something here ever needs to be secret, it needs a server.

# --- Firebase -----------------------------------------------------------------------
# From the Firebase console: Project settings → General → Your apps → SDK setup and
# configuration → Config. Copy the six values across.
#
# All six must be present for the form to submit; the client treats a partially filled
# config as unconfigured on purpose, because a config that initialises and then fails
# on every request is harder to diagnose than one that declines to start.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# App Check (reCAPTCHA v3 site key). Applications are a create-only public endpoint,
# so without attestation it will eventually be filled by a script. Set this in
# production; leave it empty locally, where reCAPTCHA cannot be exercised without a
# debug token. Firebase console → App Check → Apps → register the web app.
#
# Turn ENFORCEMENT on in the console only after confirming real submissions carry a
# token, or you will reject genuine applicants.
NEXT_PUBLIC_FIREBASE_APPCHECK_KEY=

# --- The form -----------------------------------------------------------------------

# A real cohort deadline, shown next to the form. Unset, no deadline is claimed.
# Leave it empty rather than inventing one: a countdown to a date nobody agreed
# to is the kind of claim this site exists not to make.
NEXT_PUBLIC_COHORT_DEADLINE=
